### Test API Endpoints for G45 Project

# Base URL
@baseUrl = http://127.0.0.1:8000

### 1. Register a new user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "testuser1",
    "email": "testuser1@example.com",
    "password": "password123"
}

### 2. Register another user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "testuser2",
    "email": "testuser2@example.com",
    "password": "password456"
}

### 3. Login with first user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "testuser1",
    "password": "password123"
}

### 4. Login with second user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "testuser2",
    "password": "password456"
}

### 5. Try to login with wrong password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "testuser1",
    "password": "wrongpassword"
}

### 6. Try to register with existing username
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "testuser1",
    "email": "different@example.com",
    "password": "password789"
}

### 7. Try to register with existing email
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "newuser",
    "email": "testuser1@example.com",
    "password": "password789"
}

### 8. Test with invalid JSON
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "invalid",
    "email": "invalid-email",
    "password": ""
}

### 9. Test server health (optional - if you add a health endpoint)
# GET {{baseUrl}}/health

### 10. Test with missing fields
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "username": "incomplete"
}


### MESSAGES TESTS
### Send a message to group 1
POST http://localhost:8000/groups/1/message
Content-Type: application/json

{
    "content": "Hello everyone! This is a test message.",
    "sender_id": 1
}

### Send another message to group 1
POST http://localhost:8000/groups/1/message
Content-Type: application/json

{
    "content": "How is everyone doing today?",
    "sender_id": 2
}

### Send a message to group 2
POST http://localhost:8000/groups/2/message
Content-Type: application/json

{
    "content": "This is a message for group 2",
    "sender_id": 1
}

### Get all messages from group 1
GET http://localhost:8000/groups/1/messages

### Get all messages from group 2
GET http://localhost:8000/groups/2/messages

### Get messages from non-existent group
GET http://localhost:8000/groups/999/messages

### Creazione invito

POST http://localhost:8000/invitations/invitation/create

{
  "status": 1,
  "send_at": "2025-09-02T14:30:00",
  "invited_by": 1,
  "invited_user": 2,
  "group_id": 1
}

### Accettazione invito
POST http://localhost:8000/invitations/invitation/1/accept

### Rifiuto invito
POST http://localhost:8000/invitations/invitation/1/reject


